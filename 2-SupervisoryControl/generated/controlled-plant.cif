svgout id "call0-led" attr "fill" value if Button0.Idle: "red" else "green" end file "../plant/plant.svg";
svgout id "call1-led" attr "fill" value if Button1.Idle: "red" else "green" end file "../plant/plant.svg";
svgout id "call2-led" attr "fill" value if Button2.Idle: "red" else "green" end file "../plant/plant.svg";
svgout id "door-r" attr "y" value if Cabin.F0: "203.500" elif Cabin.F1: "133.500" else "63.500" end file "../plant/plant.svg";
svgout id "door-l" attr "y" value if Cabin.F0: "203.500" elif Cabin.F1: "133.500" else "63.500" end file "../plant/plant.svg";
svgout id "inside" attr "y" value if Cabin.F0: "203.500" elif Cabin.F1: "133.500" else "63.500" end file "../plant/plant.svg";
svgout id "cabin" attr "y" value if Cabin.F0: "193.500" elif Cabin.F1: "123.500" else "53.500" end file "../plant/plant.svg";
svgout id "door-r" attr "x" value if Door.Closed: "82.600" else "92.600" end file "../plant/plant.svg";
svgout id "door-l" attr "x" value if Door.Closed: "65.400" else "55.400" end file "../plant/plant.svg";
